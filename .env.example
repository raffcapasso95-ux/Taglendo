# Copia in .env.local. Valori locali: li stampa `npx supabase status -o env`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server, mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# Accesso con Apple e Google: i pulsanti compaiono solo se il provider è acceso.
# Prima crea le app sui rispettivi portali e configura i provider in Supabase.
NEXT_PUBLIC_AUTH_APPLE=false
NEXT_PUBLIC_AUTH_GOOGLE=false

# Pagamenti. Spenti nella beta gratuita: ogni salone ha l'accesso completo, senza scadenza.
# Si accendono ("true") solo quando la Fase 6 (Stripe) è pronta e i saloni sono stati avvisati.
BILLING_ENABLED=false

# Sentry (errori in produzione). Senza DSN resta spento. Il DSN lo trovi in Sentry:
# Project Settings → Client Keys (DSN). Non contiene segreti: può stare nel browser.
NEXT_PUBLIC_SENTRY_DSN=

# Anteprima privata («a breve online»). Con SITE_PRIVATE=true il sito lo vede solo chi entra da /accesso-riservato
# con questi utente e password. PREVIEW_SECRET firma il cookie di accesso (una stringa lunga a caso).
SITE_PRIVATE=false
PREVIEW_USER=
PREVIEW_PASSWORD=
PREVIEW_SECRET=
