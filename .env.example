# Copia in .env.local. Valori locali: li stampa `npx supabase status -o env`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server, mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# Accesso con Apple e Google: i pulsanti compaiono solo se il provider è acceso.
# Prima crea le app sui rispettivi portali e configura i provider in Supabase.
NEXT_PUBLIC_AUTH_APPLE=false
NEXT_PUBLIC_AUTH_GOOGLE=false
