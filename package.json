{
  "name": "taglendo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && stylelint \"**/*.css\" --ignore-pattern \"design/**\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "vitest run --project db",
    "db:types": "supabase gen types typescript > lib/supabase/database.types.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "pg": "^8.23.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "supabase": "^3.0.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
